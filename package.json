  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@simplewebauthn/server": "^14.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.5.2",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "country-to-currency": "^3.0.1",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "i18n-iso-countries": "^7.14.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "prisma": "^6.16.2",
    "socket.io": "^4.8.4",
    "typescript": "^5.9.2",
    "zod": "^4.1.8"
